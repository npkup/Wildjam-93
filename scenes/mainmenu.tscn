[sub_resource type="GDScript" id="GDScript_r3g3c"]
script/source = "extends Control

var apreared : bool = false
@onready var sprite_2d: Sprite2D = $Sprite2D

signal proceed_pressed
signal proceed_unpressed

func _on_button_pressed() -> void:
	#get_tree().change_scene_to_file(\"res://scenes/main.tscn\")
	$Sprite2D/AnimationPlayer.play(\"aprear\")
	apreared = true
	for i in 7:
		await proceed_pressed
		sprite_2d.frame += 1
		await  proceed_unpressed
	

func _process(_delta: float) -> void:
	if Input.is_action_just_pressed(\"attack\"):
		if sprite_2d.frame == 6:
			get_tree().change_scene_to_file(\"res://scenes/main.tscn\")
		proceed_pressed.emit()
		
	if Input.is_action_just_released(\"attack\"):
		proceed_unpressed.emit()
"

